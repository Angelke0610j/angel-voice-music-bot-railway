# Discord Developer Portal > Bot
DISCORD_TOKEN=put_your_bot_token_here
DISCORD_CLIENT_ID=put_your_application_client_id_here
# Required for registering guild slash commands; use your server's ID
DISCORD_GUILD_ID=put_your_server_id_here

# Speech-to-text (OpenAI API billing may apply)
OPENAI_API_KEY=put_your_openai_api_key_here
# Name users say to wake the bot
WAKE_WORD=angel
# Optional language hint for speech transcription, e.g. en
TRANSCRIPTION_LANGUAGE=en

# Jamendo API: create an app / obtain a client ID at developer.jamendo.com
# Jamendo tracks have usage/licensing conditions; check each track's terms.
JAMENDO_CLIENT_ID=put_your_jamendo_client_id_here

# Optional: only listen in one voice channel. Leave blank to allow any channel.
ALLOWED_VOICE_CHANNEL_ID=
# Optional: only listen in one text channel for status replies. Leave blank to reply in command channel.
STATUS_CHANNEL_ID=
